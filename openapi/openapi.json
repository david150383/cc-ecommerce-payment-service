{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Service",
    "version": "1.0.0",
    "description": "Payments, webhooks, refunds, reconciliation. Semantics: docs/api.md"
  },
  "servers": [
    {
      "url": "http://localhost:4005"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SUCCEEDED",
              "FAILED",
              "EXPIRED",
              "PARTIALLY_REFUNDED",
              "REFUNDED"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "mock",
              "stripe"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "refunded": {
            "type": "object",
            "properties": {
              "amountMinor": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              }
            },
            "required": [
              "amountMinor",
              "currency"
            ]
          },
          "checkoutUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Only while PENDING"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "orderId",
          "customerId",
          "status",
          "provider",
          "amount",
          "refunded",
          "checkoutUrl",
          "expiresAt",
          "failureCode",
          "createdAt",
          "updatedAt"
        ],
        "description": "Never contains card data: the provider hosts the card form."
      },
      "Money": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance"
        ],
        "additionalProperties": {}
      },
      "CreateIntentRequest": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "returnUrl": {
            "type": "string",
            "format": "uri",
            "description": "Where the provider sends the customer afterwards. Proves nothing about payment."
          },
          "sagaId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "orderId",
          "returnUrl"
        ],
        "additionalProperties": false,
        "description": "No amount: it is read from the Order Service."
      },
      "ReopenCheckoutRequest": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "paymentId"
        ],
        "additionalProperties": false
      },
      "Refund": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "object",
            "properties": {
              "amountMinor": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              }
            },
            "required": [
              "amountMinor",
              "currency"
            ]
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "paymentId",
          "amount",
          "reason",
          "status",
          "failureCode",
          "createdAt"
        ]
      },
      "AdminRefundRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "description": "Omit for a full refund of what remains"
              }
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "ADMIN",
              "CUSTOMER_REQUESTED"
            ]
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/payments/intent": {
      "post": {
        "tags": [
          "payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create the payment + provider checkout for an order (service token: saga). Amount comes from the Order Service.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateIntentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replayed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment": {
                      "$ref": "#/components/schemas/Payment"
                    }
                  },
                  "required": [
                    "payment"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment": {
                      "$ref": "#/components/schemas/Payment"
                    }
                  },
                  "required": [
                    "payment"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "ORDER_NOT_PAYABLE / PAYMENT_EXISTS",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "ORDER_NOT_FOUND / IDEMPOTENCY_KEY_REUSED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "PROVIDER_UNAVAILABLE / DEPENDENCY_UNAVAILABLE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/checkout": {
      "post": {
        "tags": [
          "payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Re-open a still-valid checkout (owner)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReopenCheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment": {
                      "$ref": "#/components/schemas/Payment"
                    }
                  },
                  "required": [
                    "payment"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "CHECKOUT_NOT_OPEN",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{paymentId}": {
      "get": {
        "tags": [
          "payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Payment with its refunds (owner or admin)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "paymentId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment": {
                      "$ref": "#/components/schemas/Payment"
                    },
                    "refunds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Refund"
                      }
                    }
                  },
                  "required": [
                    "payment",
                    "refunds"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/webhooks/{provider}": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Provider webhooks (signature-verified over the raw body; duplicates acknowledged)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "mock",
                "stripe"
              ]
            },
            "required": true,
            "name": "provider",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "received": {
                      "type": "boolean"
                    },
                    "result": {
                      "type": "string",
                      "enum": [
                        "applied",
                        "duplicate",
                        "ignored"
                      ]
                    }
                  },
                  "required": [
                    "received",
                    "result"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SIGNATURE / MALFORMED_WEBHOOK",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{paymentId}/refund": {
      "post": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Refund (admin). 202: complete only when the provider confirms.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "paymentId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminRefundRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Requested",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "refund": {
                      "$ref": "#/components/schemas/Refund"
                    }
                  },
                  "required": [
                    "refund"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/payments": {
      "get": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Payment records (admin)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "SUCCEEDED",
                "FAILED",
                "EXPIRED",
                "PARTIALLY_REFUNDED",
                "REFUNDED"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "customerId",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Payments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Payment"
                      }
                    },
                    "page": {
                      "type": "object",
                      "properties": {
                        "limit": {
                          "type": "integer"
                        },
                        "nextCursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "limit",
                        "nextCursor"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "page"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
