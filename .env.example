NODE_ENV=development
PORT=4005
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# Shared local stack (ecommerce-infrastructure):
DATABASE_URL=postgresql://payment_svc:payment_local_pw@localhost:5432/payment_db
# Standalone (this repo: docker compose up -d):
# DATABASE_URL=postgresql://payment_svc:payment_local_pw@localhost:5445/payment_db
TEST_DATABASE_URL=postgresql://payment_svc:payment_local_pw@localhost:5432/payment_test

# Incoming tokens
JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=ecommerce-auth-service
JWT_AUDIENCE=ecommerce-api
JWT_SERVICE_AUDIENCE=ecommerce-payment-service

# Order Service (the authoritative amount), via a client-credentials token from Auth
AUTH_SERVICE_URL=http://localhost:4001
SERVICE_CLIENT_ID=ecommerce-payment-service
SERVICE_CLIENT_SECRET=payment-service-local-secret   # LOCAL ONLY
ORDER_SERVICE_URL=http://localhost:4004
DEPENDENCY_TIMEOUT_MS=5000

# Provider: mock (local only; refused when NODE_ENV=production) or stripe
PAYMENT_PROVIDER=mock
PUBLIC_BASE_URL=http://localhost:4005          # where browsers reach the mock checkout page
MOCK_WEBHOOK_SECRET=local-mock-webhook-secret  # LOCAL ONLY
MOCK_REFUND_DELAY_MS=500
CHECKOUT_EXPIRY_MINUTES=30
# Stripe TEST mode only for local work. Never commit real keys; outside local dev they come from Secrets Manager.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...              # printed by `stripe listen --forward-to localhost:4005/api/v1/payments/webhooks/stripe`

# Messaging (Floci locally)
MESSAGING_ENABLED=true
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:local-ecommerce-payment-events
COMMANDS_QUEUE_NAME=local-ecommerce-payment-commands
OUTBOX_POLL_INTERVAL_MS=500
CONSUMER_WAIT_TIME_SECONDS=20
TEST_AWS_ENDPOINT_URL=http://localhost:4566

# Reconciliation (lost webhooks)
RECONCILE_INTERVAL_MS=60000
RECONCILE_AFTER_SECONDS=300
